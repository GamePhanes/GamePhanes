{
  "schema_version": 1,
  "id": "showcase_gravity_lab_001",
  "title": "Gravity Lab",
  "description": "Invert chamber polarity, stabilize the suspended core, and cross the unlocked exit.",
  "taxonomy": { "domain": "gameplay_systems", "subdomain": "physics", "task_type": "reference_environment" },
  "registry": {
    "slug": "gravity-lab",
    "version": "gamephanes-public==0.1",
    "kind": "reference_environment",
    "evaluator_visibility": "public_reference",
    "difficulty": "unrated",
    "tags": ["godot", "2d", "physics", "state-signals", "puzzle"],
